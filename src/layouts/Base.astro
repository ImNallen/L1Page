---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';

type Props = {
  title: string;
  description: string;
  indexable?: boolean;
};

const { title, description, indexable = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/#apps', label: 'Apps' },
  { href: '/release-notes/', label: 'Release notes' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="L1 Software" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The L1 logo, the headline Every L1 app, in one place, and the L1 Data, L1 Git, and L1 Code icons." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <Logo size={26} />
          <span>L1</span>
          <span class="visually-hidden">Software, home</span>
        </a>
        <nav aria-label="Main">
          <ul class="site-nav" role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="button" href="/download/" aria-current={path === '/download/' ? 'page' : undefined}>
                Download
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <a class="site-footer__brand" href="/">
          <Logo size={20} />
          l1software.app
        </a>
        <ul class="site-footer__links" role="list">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/download/">Download</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        const iPadAsMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
        const os = iPadAsMac || /Android|iPhone|iPad|iPod|CrOS/.test(ua)
          ? null
          : /Windows/.test(ua)
            ? 'windows'
            : /Macintosh|Mac OS X/.test(ua)
              ? 'macos'
              : /Linux|X11/.test(ua)
                ? 'linux'
                : null;
        if (!os) return;
        for (const group of document.querySelectorAll('[data-os-switch]')) {
          const matches = group.querySelectorAll(`[data-os="${os}"]`);
          if (matches.length === 0) continue;
          for (const el of group.querySelectorAll('[data-os-default]')) el.hidden = true;
          for (const el of matches) el.hidden = false;
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 69px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .site-nav a:not(.button) {
    color: var(--fg-muted);
    transition: color 120ms ease;
  }

  .site-nav a:not(.button):hover,
  .site-nav a[aria-current='page'] {
    color: var(--fg);
  }

  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 13px;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    min-height: 84px;
    padding-block: 20px;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .site-footer__links {
    display: flex;
    gap: 22px;
  }

  .site-footer a:hover {
    color: var(--fg);
  }

  .site-nav a {
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .site-header__inner {
      gap: 12px;
    }

    .site-nav {
      gap: 14px;
      font-size: 14px;
    }

    .site-nav .button {
      padding-inline: 10px;
    }
  }
</style>
