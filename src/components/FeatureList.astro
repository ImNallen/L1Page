---
import type { Feature } from '../data/products';

type Props = { features: Feature[] };

const { features } = Astro.props;
---

<ul class="features" role="list">
  {
    features.map((f) => (
      <li>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    column-gap: 32px;
  }

  li {
    padding-block: 20px 28px;
    border-top: 1px solid var(--border-strong);
  }

  h3 {
    font-size: 15px;
    font-weight: 500;
  }

  p {
    margin-top: 6px;
    color: var(--fg-muted);
  }
</style>
