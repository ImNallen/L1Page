---
const paths = {
  download: 'M8 2.5v7.5m0 0L5 7m3 3 3-3M2.75 10.5v1.75c0 .69.56 1.25 1.25 1.25h8c.69 0 1.25-.56 1.25-1.25V10.5',
  chevron: 'M6.5 4.5 10 8l-3.5 3.5',
};

type Props = { name: keyof typeof paths; size?: number };

const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
