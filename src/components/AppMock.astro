---
const columns = ['id', 'email', 'total', 'status', 'created_at'];
const rows = [
  [48213, 'maya.okafor@fastmail.com', '129.00', 'paid', '2026-10-22 18:41:07'],
  [48212, 'j.lindqvist@proton.me', '42.50', 'paid', '2026-10-22 18:37:52'],
  [48211, 'priya.raman@gmail.com', '310.75', 'refunded', '2026-10-22 18:12:30'],
  [48210, 'tom@hartleyandsons.co.uk', '18.00', 'pending', '2026-10-22 17:58:14'],
  [48209, 'ana.ferreira@outlook.com', '76.20', 'paid', '2026-10-22 17:44:03'],
  [48208, 'kenji.watanabe@icloud.com', '1,204.00', 'paid', '2026-10-22 17:20:49'],
  [48207, 'luca.bianchi@libero.it', '64.90', 'failed', '2026-10-22 16:59:31'],
  [48206, 'sara.nilsson@telia.se', '23.40', 'paid', '2026-10-22 16:47:18'],
];
const tables = ['customers', 'order_items', 'products', 'refunds'];
const orderColumns = [
  ['id', 'bigint'],
  ['customer_id', 'bigint'],
  ['total_cents', 'integer'],
  ['status', 'order_status'],
  ['created_at', 'timestamptz'],
];
---

<figure class="mock" role="img" aria-label="The L1 Data window: a schema tree for a PostgreSQL database, a SQL query that joins orders to customers, and a grid of eight result rows.">
  <div class="mock__bar">
    <span class="mock__title">L1 Data</span>
    <span class="mock__conn">shop on prod-replica</span>
  </div>
  <div class="mock__body">
    <div class="mock__tree">
      <p class="mock__pane-title">Database</p>
      <ul>
        <li class="t1 open">prod-replica <span class="dim">PostgreSQL 16</span></li>
        <li class="t2 open">shop</li>
        <li class="t3 open">public</li>
        <li class="t4 open">tables</li>
        <li class="t5 tbl">{tables[0]}</li>
        <li class="t5 tbl open active">orders</li>
        {
          orderColumns.map(([name, type]) => (
            <li class="t6 col">
              {name} <span class="dim">{type}</span>
            </li>
          ))
        }
        {tables.slice(1).map((t) => <li class="t5 tbl">{t}</li>)}
        <li class="t4">views</li>
        <li class="t4">functions</li>
      </ul>
    </div>
    <div class="mock__main">
      <div class="mock__tabs">
        <span class="mock__tab is-active">orders_last_week.sql</span>
        <span class="mock__tab">revenue_by_day.sql</span>
      </div>
      <pre class="mock__editor"><code><span class="ln">1</span><span class="kw">select</span> o.id, c.email,
<span class="ln">2</span>       o.total_cents <span class="op">/</span> <span class="num">100.0</span> <span class="kw">as</span> total,
<span class="ln">3</span>       o.status, o.created_at
<span class="ln">4</span><span class="kw">from</span> orders o
<span class="ln">5</span><span class="kw">join</span> customers c <span class="kw">on</span> c.id <span class="op">=</span> o.customer_id
<span class="ln">6</span><span class="kw">where</span> o.created_at <span class="op">&gt;=</span> <span class="fn">now</span>() <span class="op">-</span> <span class="kw">interval</span> <span class="str">'7 days'</span>
<span class="ln">7</span><span class="kw">order by</span> o.created_at <span class="kw">desc</span>
<span class="ln">8</span><span class="kw">limit</span> <span class="num">100</span>;<span class="caret"></span></code></pre>
      <div class="mock__results">
        <table>
          <thead>
            <tr>
              <th></th>
              {columns.map((c) => <th>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row, i) => (
                <tr>
                  <td class="rn">{i + 1}</td>
                  {row.map((cell, j) => (
                    <td class:list={[{ num: j === 0 || j === 2, sel: i === 2 && j === 3 }]}>{cell}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="mock__status">
        <span>100 rows</span>
        <span>38 ms</span>
        <span class="mock__status-end">UTF-8</span>
      </div>
    </div>
  </div>
</figure>
