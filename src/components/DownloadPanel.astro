---
import { buildName, formatDate, latestRelease, listPlatforms, type Product } from '../data/products';

type Props = { product: Product };

const { product } = Astro.props;
const release = latestRelease(product);
---

<div class="downloads">
  {
    release ? (
      <div class="downloads__available" data-downloads>
        <p class="downloads__meta">
          <span class="tag">Version {release.version}</span>
          Released {formatDate(release.date)}.
        </p>
        <p class="downloads__primary" data-primary hidden>
          <a class="button button--primary" href="#">
            Download
          </a>
        </p>
        <h3>All builds</h3>
        <ul class="builds">
          {release.downloads.map((d) => (
            <li data-platform={d.platform} data-name={buildName(d)}>
              <a href={d.url}>{buildName(d)}</a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="downloads__soon">
        <p class="tag">Not released yet</p>
        <p>
          {product.name} is in development and there is nothing to download yet. When it is released, builds for{' '}
          {listPlatforms(product.platforms)} will be listed here.
        </p>
      </div>
    )
  }
</div>
