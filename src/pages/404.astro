---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | L1 Software" description="There is no page at this address.">
  <section class="hero hero--compact wrap" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display">Page not found</h1>
    <div class="hero__aside">
      <p class="lede">The lookup for this address returned 0 rows. The link may be old or mistyped.</p>
      <p class="actions">
        <a class="button button--primary" href="/">Go to the home page</a>
        <a class="button" href="/download/">Downloads</a>
      </p>
    </div>
  </section>
</Base>
