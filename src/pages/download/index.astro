---
import Base from '../../layouts/Base.astro';
import AppTile from '../../components/AppTile.astro';
import DownloadBlock from '../../components/DownloadBlock.astro';
import { listNames, products } from '../../data/products';
---

<Base title="Download L1 apps" description={`Builds of ${listNames(products)} for macOS, Windows, and Linux.`}>
  <section class="wrap page-head" aria-labelledby="hero-title">
    <h1 id="hero-title">Download</h1>
    <p class="muted">Every L1 app and its builds for the latest version.</p>
  </section>

  <div class="wrap downloads">
    {
      products.map((product) => (
        <section class="download" aria-labelledby={`dl-${product.slug}`}>
          <div class="download__head">
            <AppTile icon={product.icon} size={44} />
            <div>
              <h2 id={`dl-${product.slug}`}>
                <a href={`/${product.slug}/`}>{product.name}</a>
              </h2>
              <p class="muted">{product.tagline}</p>
            </div>
          </div>
          <DownloadBlock product={product} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .downloads {
    margin-top: 48px;
  }

  .download {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 24px 48px;
    padding-block: 32px;
  }

  .download__head {
    display: flex;
    align-items: start;
    gap: 16px;
  }

  h2 {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .download {
      grid-template-columns: 1fr;
    }
  }
</style>
